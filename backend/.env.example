# Supabase Configuration
# Obtain from your Supabase project settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: enables scripts/apply_migration.py (Settings → Database → password)
# SUPABASE_DB_PASSWORD=your-database-password
# Or full URI:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.your-project.supabase.co:5432/postgres

# Server Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

# Machine Learning Paths (relative to backend/ or absolute)
MODEL_DIR=../HomeCreditProject/models
ARTIFACTS_DIR=../HomeCreditProject/artifacts
MODEL_VERSION=lightgbm-homecredit-10fold-v1
